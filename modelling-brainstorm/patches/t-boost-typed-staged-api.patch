+def test_seeded_models_share_no_reports_with_candidates_or_siblings(route, kind):
+    from copy import deepcopy
+    x, y = book()
+    session = estimator().fit_staged(x, y)
+    session.apply(PRUNE)
+    request = BandPath(fractions=(.25, 1.)) if kind == 'banded' else SmoothPath(Smooth('pruned'), (.5, 2.))
+    family = session.prepare_path(request)
+    first, second = family.candidates[1], family.candidates[2]
+    # Both models are the seeds their candidates were prepared with.
+    model = first.result().model if route == 'result' else session.fork().apply(first).model
+    sibling = second.result().model
+    reports = ('pruning_report_', 'graduation_report_', 'graduation_validation_')
+    baseline = {name: deepcopy(getattr(sibling, name, None)) for name in reports}
+    payload, diagnostics = first.to_bytes(), first.diagnostics
+    key = 'banding' if kind == 'banded' else 'graduation_validation'
+    model.pruning_report_[key]['tampered'] = True
+    for report in getattr(model, 'graduation_report_', None) or []:
+        for value in report.values():
+            if isinstance(value, list):
+                value.append('tampered')
+    assert {name: getattr(sibling, name, None) for name in reports} == baseline
+    assert (first.to_bytes(), first.diagnostics) == (payload, diagnostics)
