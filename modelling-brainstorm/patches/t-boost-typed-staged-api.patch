+def test_candidates_apply_to_forks_and_restore_with_one_build(monkeypatch):
+    x, y = book()
+    session = estimator().fit_staged(x, y)
+    session.apply(PRUNE)
+    family = session.prepare_path(SmoothPath(Smooth('pruned'), (.5, 2.)))
+    candidate = family.candidate('point-2')
+    fork = session.fork()
+    fork.apply(candidate)
+    assert 'smoothed' in fork.stages and 'smoothed' not in session.stages
+    assert fork.stages['smoothed'].revision == candidate.result().info.revision
+    builds = []
+    original = TBoostRegressor.from_json.__func__
+
+    def counted(cls, document):
+        builds.append(1)
+        return original(cls, document)
+
+    monkeypatch.setattr(TBoostRegressor, 'from_json', classmethod(counted))
+    restored = TBoostCandidate.from_bytes(session.fork(), candidate.to_bytes())
+    result = session.fork().apply(restored)
+    result.model.predict(x)
+    assert len(builds) == 1  # validation's estimator is the applied result's model
+
