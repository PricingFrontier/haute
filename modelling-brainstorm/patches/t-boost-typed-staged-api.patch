+"""Staged-training values: operations, recipes, path requests and stage identities.
+
+Every value is frozen and validates itself on construction. ``settings()`` returns the
+exact dictionary a stage revision hashes; nothing else feeds revisions. ``to_plain_data``
+and ``from_plain_data`` are the strict, JSON-compatible storage forms.
+"""
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass, field
+from typing import Any, ClassVar, Literal, Union, cast
+
+StageName = Literal["full", "pruned", "banded", "smoothed"]
+PostFitStage = Literal["pruned", "banded", "smoothed"]
+CandidateStatus = Literal["identity", "changed", "unchanged", "rejected"]
+
+STAGES: tuple[str, ...] = ("full", "pruned", "banded", "smoothed")
+POST_FIT: tuple[str, ...] = ("pruned", "banded", "smoothed")
+CANDIDATE_STATUSES: tuple[str, ...] = ("identity", "changed", "unchanged", "rejected")
+RECIPE_SCHEMA_VERSION = 1
+
+# The automatic pruning selection's defaults.
+PRUNE_FRACTION = 0.995
+PRUNE_TOLERANCE = 0.001
+
+
+def _number(value: Any) -> bool:
+    """A finite real number; booleans are never numbers here."""
+    return (not isinstance(value, bool) and isinstance(value, (int, float))
+            and math.isfinite(value))
+
+
+def _integer(value: Any, minimum: int) -> bool:
+    return type(value) is int and value >= minimum
+
+
+def _fail(message: str) -> None:
+    raise ValueError(message)
+
+
+def _keys(value: Any, required: set[str], optional: frozenset[str] = frozenset(), *,
+          what: str) -> dict[str, Any]:
+    if not isinstance(value, dict) or not required <= set(value) <= required | optional:
+        _fail(f"invalid {what}")
+    return cast(dict[str, Any], value)
+
+
+@dataclass(frozen=True)
+class PruningPathSettings:
+    """How the structural out-of-bag pruning evidence is built for a fit."""
+
+    steps: int = 32
+    main_effects: bool = False
+    min_rows: int = 500
+
+    def __post_init__(self) -> None:
+        if (not _integer(self.steps, 2) or not _integer(self.min_rows, 1)
+                or type(self.main_effects) is not bool):
+            _fail("pruning path steps must be an integer >= 2, min_rows an integer >= 1, "
+                  "and main_effects a boolean")
+
+    def estimator_params(self) -> dict[str, Any]:
+        """The estimator parameters these settings correspond to."""
+        return dict(prune_path_steps=self.steps, prune_main_effects=self.main_effects,
+                    prune_guard_min_rows=self.min_rows)
+
+    def to_plain_data(self) -> dict[str, Any]:
+        return dict(steps=self.steps, main_effects=self.main_effects, min_rows=self.min_rows)
+
+    @classmethod
+    def from_plain_data(cls, value: Any) -> PruningPathSettings:
+        value = _keys(value, {"steps", "main_effects", "min_rows"}, what="pruning path settings")
+        return cls(value["steps"], value["main_effects"], value["min_rows"])
+
+
+@dataclass(frozen=True)
+class Prune:
+    """Select tables along the out-of-bag pruning path built with ``path``.
+
+    ``max_tables`` (a total-table budget, counting mandatory main effects) is used with
+    the default ``fraction`` and ``tolerance`` only.
+    """
+
+    stage: ClassVar[str] = "pruned"
+    parent: ClassVar[str] = "full"
+    fraction: float = PRUNE_FRACTION
+    tolerance: float = PRUNE_TOLERANCE
+    max_tables: int | None = None
+    path: PruningPathSettings = field(default_factory=PruningPathSettings)
+
+    def __post_init__(self) -> None:
+        if (not _number(self.fraction) or not 0 < self.fraction <= 1
+                or not _number(self.tolerance) or self.tolerance < 0):
+            _fail("fraction must be finite in (0, 1] and tolerance finite and non-negative")
+        if self.max_tables is not None and (
+                not _integer(self.max_tables, 0) or self.fraction != PRUNE_FRACTION
+                or self.tolerance != PRUNE_TOLERANCE):
+            _fail("max_tables must be a non-negative integer used without fraction/tolerance")
+        if not isinstance(self.path, PruningPathSettings):
+            _fail("Prune.path must be PruningPathSettings")
+
+    def settings(self) -> dict[str, Any]:
+        # The path settings are recorded in the stage's inference document, which the
+        # revision hashes, so they are not repeated here.
+        return dict(fraction=self.fraction, tolerance=self.tolerance, max_tables=self.max_tables)
+
+    def to_plain_data(self) -> dict[str, Any]:
+        return dict(stage=self.stage, parent=self.parent, settings=self.settings(),
+                    path=self.path.to_plain_data())
+
+    @classmethod
+    def from_plain_data(cls, value: Any) -> Prune:
+        operation = operation_from_plain_data(value)
+        if not isinstance(operation, cls):
+            _fail("invalid prune operation")
+        return cast(Prune, operation)
+
+
+@dataclass(frozen=True)
+class Band:
+    """Merge bins using retained bag evidence."""
+
+    stage: ClassVar[str] = "banded"
+    parent: Literal["full", "pruned"] = "pruned"
+    tolerance: float = 0.75
+    deviance_cap: float = 0.001
+
+    def __post_init__(self) -> None:
+        if self.parent not in ("full", "pruned"):
+            _fail("banding parent must be full or pruned")
+        if (not _number(self.tolerance) or self.tolerance <= 0
+                or not _number(self.deviance_cap) or self.deviance_cap <= 0):
+            _fail("banding tolerance and deviance_cap must be finite and positive")
+
+    def settings(self) -> dict[str, Any]:
+        return dict(tolerance=self.tolerance, deviance_cap=self.deviance_cap)
+
+    def to_plain_data(self) -> dict[str, Any]:
+        return dict(stage=self.stage, parent=self.parent, settings=self.settings())
+
+    @classmethod
+    def from_plain_data(cls, value: Any) -> Band:
+        operation = operation_from_plain_data(value)
+        if not isinstance(operation, cls):
+            _fail("invalid band operation")
+        return cast(Band, operation)
+
+
+@dataclass(frozen=True)
+class Smooth:
+    """Graduate the parent's tables: Auto (``alpha=None``, scaled by ``strength``) or a
+    manual ``alpha`` (with strength 1)."""
+
+    stage: ClassVar[str] = "smoothed"
+    parent: Literal["full", "pruned", "banded"] = "banded"
+    alpha: float | None = None
+    high_order_alpha: float = 0.0
+    strength: float = 1.0
+
+    def __post_init__(self) -> None:
+        if self.parent not in ("full", "pruned", "banded"):
+            _fail("smoothing parent must be full, pruned or banded")
+        if not _number(self.strength) or self.strength <= 0 or (
+                self.alpha is not None and self.strength != 1):
+            _fail("Auto smoothing strength must be finite and positive; manual alpha uses strength 1")
+        if self.alpha is not None and (not _number(self.alpha) or self.alpha < 0):
+            _fail("smoothing alpha must be None or finite and non-negative")
+        if not _number(self.high_order_alpha) or not 0 <= self.high_order_alpha <= 1:
+            _fail("graduation_high_order_alpha must be finite and in [0, 1]")
+
+    def settings(self) -> dict[str, Any]:
+        value: dict[str, Any] = dict(alpha=self.alpha, high_order_alpha=self.high_order_alpha)
+        if self.strength != 1:
+            value["strength"] = self.strength
+        return value
+
+    def to_plain_data(self) -> dict[str, Any]:
+        return dict(stage=self.stage, parent=self.parent, settings=self.settings())
+
+    @classmethod
+    def from_plain_data(cls, value: Any) -> Smooth:
+        operation = operation_from_plain_data(value)
+        if not isinstance(operation, cls):
+            _fail("invalid smooth operation")
+        return cast(Smooth, operation)
+
+
+Operation = Union[Prune, Band, Smooth]
+_OPERATIONS: dict[str, type] = {"pruned": Prune, "banded": Band, "smoothed": Smooth}
+
+
+def operation_from_plain_data(value: Any) -> Operation:
+    """Decode an operation's storage form strictly."""
+    if not isinstance(value, dict) or value.get("stage") not in _OPERATIONS:
+        _fail("invalid recipe operation")
+    stage = value["stage"]
+    value = _keys(value, {"stage", "parent", "settings"} | ({"path"} if stage == "pruned" else set()),
+                  what="recipe operation")
+    settings = value["settings"]
+    if stage == "pruned":
+        settings = _keys(settings, {"fraction", "tolerance", "max_tables"}, what="pruning settings")
+        if value["parent"] != "full":
+            _fail("pruning parent must be full")
+        return Prune(settings["fraction"], settings["tolerance"], settings["max_tables"],
+                     PruningPathSettings.from_plain_data(value["path"]))
+    if stage == "banded":
+        settings = _keys(settings, {"tolerance", "deviance_cap"}, what="banding settings")
+        return Band(value["parent"], settings["tolerance"], settings["deviance_cap"])
+    settings = _keys(settings, {"alpha", "high_order_alpha"}, frozenset({"strength"}),
+                     what="smoothing settings")
+    if "strength" in settings and settings["strength"] == 1:
+        _fail("smoothing settings record strength only when it is not 1")
+    return Smooth(value["parent"], settings["alpha"], settings["high_order_alpha"],
+                  settings.get("strength", 1.0))
+
+
+def _operation(value: Any) -> Operation:
+    if not isinstance(value, (Prune, Band, Smooth)):
+        _fail("recipe operations must be Prune, Band or Smooth")
+    return cast(Operation, value)
+
+
+@dataclass(frozen=True)
+class Recipe:
+    """A continuous chain of operations from ``full``: portable policy across fits."""
+
+    operations: tuple[Operation, ...] = ()
+
+    def __post_init__(self) -> None:
+        if isinstance(self.operations, (str, bytes)) or not hasattr(self.operations, "__iter__"):
+            _fail("recipe operations must be a sequence")
+        operations = tuple(_operation(op) for op in self.operations)
+        object.__setattr__(self, "operations", operations)
+        if len(operations) > 3:
+            _fail("recipe must hold at most three operations")
+        parent = "full"
+        for operation in operations:
+            if operation.parent != parent:
+                _fail("recipe must form a continuous chain starting from full")
+            parent = operation.stage
+
+    @property
+    def stage(self) -> str:
+        """The stage this recipe produces."""
+        return self.operations[-1].stage if self.operations else "full"
+
+    def to_plain_data(self) -> dict[str, Any]:
+        return dict(schema_version=RECIPE_SCHEMA_VERSION,
+                    operations=[op.to_plain_data() for op in self.operations])
+
+    @classmethod
+    def from_plain_data(cls, value: Any) -> Recipe:
+        value = _keys(value, {"schema_version", "operations"}, what="recipe")
+        if value["schema_version"] != RECIPE_SCHEMA_VERSION or type(value["schema_version"]) is not int:
+            _fail("unsupported recipe schema version")
+        if not isinstance(value["operations"], list):
+            _fail("invalid recipe")
+        return cls(tuple(operation_from_plain_data(op) for op in value["operations"]))
+
+
+@dataclass(frozen=True)
+class StageInfo:
+    """A published stage's identity and the operation that produced it."""
+
+    stage: StageName
+    revision: str
+    parent: StageName | None
+    parent_revision: str | None
+    operation: Operation | None
+
+    def __post_init__(self) -> None:
+        if self.stage not in STAGES or not isinstance(self.revision, str):
+            _fail("invalid stage info")
+        if self.stage == "full":
+            if self.parent is not None or self.parent_revision is not None or self.operation is not None:
+                _fail("the full stage has no parent or operation")
+        else:
+            operation = _operation(self.operation)
+            if (operation.stage != self.stage or operation.parent != self.parent
+                    or not isinstance(self.parent_revision, str)):
+                _fail("invalid stage info")
+
+    def to_plain_data(self) -> dict[str, Any]:
+        return dict(stage=self.stage, revision=self.revision, parent=self.parent,
+                    parent_revision=self.parent_revision,
+                    operation=None if self.operation is None else self.operation.to_plain_data())
+
+    @classmethod
+    def from_plain_data(cls, value: Any) -> StageInfo:
+        value = _keys(value, {"stage", "revision", "parent", "parent_revision", "operation"},
+                      what="stage info")
+        operation = None if value["operation"] is None else operation_from_plain_data(value["operation"])
+        return cls(value["stage"], value["revision"], value["parent"], value["parent_revision"], operation)
+
+
+def _schedule(values: Any, *, what: str) -> tuple[Any, ...] | None:
+    if values is None:
+        return None
+    if isinstance(values, (str, bytes)) or not hasattr(values, "__iter__"):
+        _fail(f"{what} must be a sequence")
+    result: tuple[Any, ...] = tuple(values)
+    if not 1 <= len(result) <= 16:
+        _fail(f"{what} must hold 1..16 values")
+    return result
+
+
+@dataclass(frozen=True)
+class PrunePath:
+    """Pruning candidates at total-table budgets, each ``Prune(max_tables=budget,
+    path=selection.path)``. By default, the budgets are ``pruning_budgets(selection)``."""
+
+    selection: Prune = field(default_factory=Prune)
+    budgets: tuple[int, ...] | None = None
+
+    stage: ClassVar[str] = "pruned"
+
+    def __post_init__(self) -> None:
+        if not isinstance(self.selection, Prune):
+            _fail("PrunePath.selection must be a Prune")
+        budgets = _schedule(self.budgets, what="pruning path budgets")
+        if budgets is not None and any(not _integer(v, 0) for v in budgets):
+            _fail("pruning path requires 1..16 non-negative integer table budgets")
+        object.__setattr__(self, "budgets", budgets)
+
+    @property
+    def parent(self) -> str:
+        return "full"
+
+    def operation(self, budget: int) -> Prune:
+        return Prune(max_tables=budget, path=self.selection.path)
+
+
+_BAND_FRACTIONS = (1 / 32, 1 / 16, 1 / 8, 1 / 4, 1 / 2, 1.0)
+_SMOOTH_STRENGTHS = (0.25, 0.5, 1.0, 2.0, 4.0)
+
+
+@dataclass(frozen=True)
+class BandPath:
+    """Banding candidates at budget fractions m in (0, 1] of ``base``'s maxima: each is
+    ``Band(base.parent, sqrt(m) * base.tolerance, m * base.deviance_cap)``."""
+
+    base: Band = field(default_factory=Band)
+    fractions: tuple[float, ...] | None = None
+
+    stage: ClassVar[str] = "banded"
+
+    def __post_init__(self) -> None:
+        if not isinstance(self.base, Band):
+            _fail("BandPath.base must be a Band")
+        fractions = _schedule(self.fractions, what="banding path fractions")
+        if fractions is not None and any(not _number(v) or v <= 0 for v in fractions):
+            _fail("path requires 1..16 finite positive strengths")
+        if fractions is not None and any(v > 1 for v in fractions):
+            _fail("banding path cannot exceed its maximum budgets")
+        object.__setattr__(self, "fractions", fractions)
