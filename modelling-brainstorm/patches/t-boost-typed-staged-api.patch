+def test_prepared_candidates_and_relative_smoothing_reuse_their_estimators(monkeypatch):
+    x, y = book()
+    session = estimator().fit_staged(x, y)
+    session.apply(PRUNE)
+    families = [session.prepare_path(PrunePath(PRUNE)), session.prepare_path(BandPath()),
+                session.prepare_path(SmoothPath(Smooth('pruned')))]
+    builds = []
+    original = TBoostRegressor.from_json.__func__
+    monkeypatch.setattr(TBoostRegressor, 'from_json',
+                        classmethod(lambda cls, doc: builds.append(1) or original(cls, doc)))
+    for family in families:
+        for candidate in family.candidates[1:]:
+            first = candidate.result().model
+            second = candidate.result().model
+            assert first is not second  # the seed is handed over once
+    assert len(builds) == sum(len(f.candidates) - 1 for f in families)
+    result = session.apply(Smooth('pruned', strength=2.))  # solved by a one-point family
+    builds.clear()
+    result.model.predict(x)
+    assert builds == []  # the applied result holds the candidate's estimator
