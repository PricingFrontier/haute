+/// Each axis's `(raw id, categorical TS encoding or None)`: the `raw` and
+/// `kind.CategoricalTS.encoding` fields of `to_json()`'s `provenance` entries.
+fn provenance_pairs(provenance: &[AxisProvenance]) -> Vec<(u32, Option<u8>)> {
+    provenance
+        .iter()
+        .map(|axis| {
+            let encoding = match axis.kind {
+                AxisKind::CategoricalTS { encoding } => Some(encoding.0),
+                AxisKind::Numeric | AxisKind::Missing => None,
+            };
+            (axis.raw.0, encoding)
+        })
+        .collect()
+}
+
+/// `(loss, tweedie_rho)` exactly as `to_json()`'s `schema.objective` reports them. The loss is
+/// its wire name. The `f32` power is rendered by the same JSON float formatting as the wire
+/// format and read back as `f64`, so it equals what parsing `to_json()` gives bit for bit
+/// (a non-finite power renders as JSON `null`, i.e. absent).
+fn objective_pair(tag: &ObjectiveTag) -> PyResult<(String, Option<f64>)> {
+    let json_error =
+        |err: serde_json::Error| PyValueError::new_err(format!("objective tag: {err}"));
+    let loss = match serde_json::to_value(tag.loss).map_err(json_error)? {
+        serde_json::Value::String(name) => name,
+        other => {
+            return Err(PyValueError::new_err(format!(
+                "objective loss has no wire name: {other}"
+            )))
+        }
+    };
+    let rho = match tag.tweedie_rho {
+        None => None,
+        Some(power) => {
+            let text = serde_json::to_string(&power).map_err(json_error)?;
+            if text == "null" {
+                None
+            } else {
+                Some(text.parse::<f64>().map_err(|err| {
+                    PyValueError::new_err(format!("objective tweedie_rho {text:?}: {err}"))
+                })?)
+            }
+        }
+    };
+    Ok((loss, rho))
+}
+
+/// `(parsed, kind)` for a JSON document: when `parsed`, `kind` is exactly what
+/// `json.loads(text).get("kind")` answers for a string `kind` (`None` for a non-object, or an
+/// absent or non-string `kind`; a repeated key keeps its last value, as Python's parser does),
+/// found without building the document's Python objects. `parsed` is false whenever the
+/// probe's answer could differ from Python's: text that is not valid UTF-8 (a lone surrogate),
+/// NaN/Infinity literals, numbers outside `f64` (Python also bounds integer digits), nesting
+/// deeper than serde_json's recursion limit (below Python's), or malformed text. The caller
+/// then applies the same rule with Python's own parser, so answers and errors are unchanged.
+#[pyfunction]
+fn _json_kind_probe(text: &Bound<'_, pyo3::types::PyString>) -> (bool, Option<String>) {
+    let Ok(text) = text.to_str() else {
+        return (false, None);
+    };
+    match serde_json::from_str::<JsonKindProbe>(text) {
+        Ok(JsonKindProbe(kind)) => (true, kind),
+        Err(_) => (false, None),
+    }
+}
+
+/// Consumes any JSON value through `deserialize_any`, so serde_json applies its recursion limit
+/// and number range checks to skipped content too (`IgnoredAny` scans without either).
+struct JsonSkip;
+
+impl<'de> serde::Deserialize<'de> for JsonSkip {
+    fn deserialize<D: serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        struct SkipVisitor;
+
+        impl<'de> serde::de::Visitor<'de> for SkipVisitor {
+            type Value = JsonSkip;
+
+            fn expecting(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+                formatter.write_str("a JSON value")
+            }
+
+            fn visit_map<A: serde::de::MapAccess<'de>>(
+                self,
+                mut map: A,
+            ) -> Result<JsonSkip, A::Error> {
+                while map.next_entry::<JsonSkip, JsonSkip>()?.is_some() {}
+                Ok(JsonSkip)
+            }
+
+            fn visit_seq<A: serde::de::SeqAccess<'de>>(
+                self,
+                mut seq: A,
+            ) -> Result<JsonSkip, A::Error> {
+                while seq.next_element::<JsonSkip>()?.is_some() {}
+                Ok(JsonSkip)
+            }
+
+            fn visit_bool<E>(self, _: bool) -> Result<JsonSkip, E> {
+                Ok(JsonSkip)
+            }
+
+            fn visit_i64<E>(self, _: i64) -> Result<JsonSkip, E> {
+                Ok(JsonSkip)
+            }
+
+            fn visit_u64<E>(self, _: u64) -> Result<JsonSkip, E> {
+                Ok(JsonSkip)
+            }
+
+            fn visit_f64<E>(self, _: f64) -> Result<JsonSkip, E> {
+                Ok(JsonSkip)
+            }
+
+            fn visit_str<E>(self, _: &str) -> Result<JsonSkip, E> {
+                Ok(JsonSkip)
+            }
+
+            fn visit_unit<E>(self) -> Result<JsonSkip, E> {
+                Ok(JsonSkip)
+            }
+        }
+
+        deserializer.deserialize_any(SkipVisitor)
+    }
+}
+
+/// The top-level string `kind` of any JSON value (see [`_json_kind_probe`]).
+struct JsonKindProbe(Option<String>);
+
+impl<'de> serde::Deserialize<'de> for JsonKindProbe {
+    fn deserialize<D: serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        struct ValueVisitor;
+
+        impl<'de> serde::de::Visitor<'de> for ValueVisitor {
+            type Value = JsonKindProbe;
+
+            fn expecting(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+                formatter.write_str("a JSON value")
+            }
+
+            fn visit_map<A: serde::de::MapAccess<'de>>(
+                self,
+                mut map: A,
+            ) -> Result<JsonKindProbe, A::Error> {
+                let mut kind = None;
+                while let Some(key) = map.next_key::<String>()? {
+                    if key == "kind" {
+                        // Every occurrence is read; the last one wins, as in `json.loads`.
+                        kind = match map.next_value::<serde_json::Value>()? {
+                            serde_json::Value::String(value) => Some(value),
+                            _ => None,
+                        };
+                    } else {
+                        map.next_value::<JsonSkip>()?;
+                    }
+                }
+                Ok(JsonKindProbe(kind))
+            }
+
+            fn visit_seq<A: serde::de::SeqAccess<'de>>(
+                self,
+                mut seq: A,
+            ) -> Result<JsonKindProbe, A::Error> {
+                while seq.next_element::<JsonSkip>()?.is_some() {}
+                Ok(JsonKindProbe(None))
+            }
+
+            fn visit_bool<E>(self, _: bool) -> Result<JsonKindProbe, E> {
+                Ok(JsonKindProbe(None))
+            }
+
+            fn visit_i64<E>(self, _: i64) -> Result<JsonKindProbe, E> {
+                Ok(JsonKindProbe(None))
+            }
+
+            fn visit_u64<E>(self, _: u64) -> Result<JsonKindProbe, E> {
+                Ok(JsonKindProbe(None))
+            }
+
+            fn visit_f64<E>(self, _: f64) -> Result<JsonKindProbe, E> {
+                Ok(JsonKindProbe(None))
+            }
+
+            fn visit_str<E>(self, _: &str) -> Result<JsonKindProbe, E> {
+                Ok(JsonKindProbe(None))
+            }
+
+            fn visit_unit<E>(self) -> Result<JsonKindProbe, E> {
+                Ok(JsonKindProbe(None))
+            }
+        }
+
+        deserializer.deserialize_any(ValueVisitor)
+    }
+}
