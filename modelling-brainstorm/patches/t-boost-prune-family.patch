+#[cfg(test)]
+mod family_wave_tests {
+    use super::{
+        family_wave, feature_set_from_raw_ids, FAMILY_DESIGN_BYTES, FAMILY_WORKING_BYTES_PER_ROW,
+    };
+
+    #[test]
+    fn a_wave_holds_at_least_one_and_at_most_the_threads_and_requests() {
+        let keepsets = vec![
+            vec![
+                feature_set_from_raw_ids(&[0]),
+                feature_set_from_raw_ids(&[0, 1]),
+            ],
+            vec![feature_set_from_raw_ids(&[0])],
+        ];
+        assert_eq!(family_wave(1000, 2, 2, &keepsets, 32), 2); // bounded by the requests
+        assert_eq!(family_wave(1000, 2, 2, &keepsets, 1), 1); // bounded by the threads
+        assert_eq!(family_wave(1000, 2, 2, &[], 8), 1);
+        // A candidate larger than the whole budget still runs, one at a time.
+        assert_eq!(family_wave(FAMILY_DESIGN_BYTES, 2, 2, &keepsets, 32), 1);
+    }
+
+    #[test]
+    fn a_wave_accounts_for_every_row_proportional_allocation() {
+        let per_call = |rows: usize, raw: usize, axes: usize, kept: usize| {
+            rows * (raw * 4 + axes * 2 + kept * 4 + FAMILY_WORKING_BYTES_PER_ROW)
+        };
+        // Wide inputs with narrow keep-sets: the bank build's row map dominates the design.
+        let narrow: Vec<_> = (0..5).map(|f| feature_set_from_raw_ids(&[f])).collect();
+        let keepsets = vec![narrow; 10];
+        let rows = 2_000_000;
+        let wave = family_wave(rows, 200, 200, &keepsets, 32);
+        assert_eq!(wave, 1);
+        let wave = family_wave(100_000, 200, 200, &keepsets, 32);
+        assert_eq!(wave, FAMILY_DESIGN_BYTES / per_call(100_000, 200, 200, 5));
+        assert!(wave * per_call(100_000, 200, 200, 5) <= FAMILY_DESIGN_BYTES);
+        // Wide keep-sets over few features: the design term matters.
+        let wide: Vec<_> = (0..50).map(|f| feature_set_from_raw_ids(&[f])).collect();
+        let wave = family_wave(1_000_000, 10, 10, &vec![wide; 10], 32);
+        assert_eq!(wave, FAMILY_DESIGN_BYTES / per_call(1_000_000, 10, 10, 50));
+        // A narrow model is dominated by the rebalance's working buffers, measured at about
+        // 92 MB per candidate for a million rows with one feature and one kept table.
+        let one = vec![vec![feature_set_from_raw_ids(&[0])]; 16];
+        let wave = family_wave(1_000_000, 1, 1, &one, 32);
+        assert!(per_call(1_000_000, 1, 1, 1) >= 92_000_000 * 14 / 10);
+        assert!(wave * 92_000_000 <= FAMILY_DESIGN_BYTES);
+    }
+}
