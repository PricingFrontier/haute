+def test_native_pruning_family_matches_separate_prunes_without_mutation(categorical, n_jobs):
+    """One `apply_keepset_family` call gives every budget exactly what `prune` gives alone.
+
+    ``n_jobs=1`` prunes one keep-set per wave; ``n_jobs=3`` prunes them concurrently.
+    """
+    from copy import copy
+    x, y = book()
+    training = x
+    if categorical:
+        import polars as pl
+        training = pl.DataFrame({"a": x[:, 0], "b": x[:, 1], "c": x[:, 2],
+                                 "region": np.where(x[:, 3] > 0, "north", "south")})
+    fit = estimator(prune_rebalance=True)
+    fit.n_jobs = n_jobs
+    session = fit.fit_staged(training, y)
+    counts = session.pruning_path['table_counts']
+    budgets = [counts[0], counts[len(counts) // 2], counts[-1], counts[0]]
+    stages = dict(session._stages)
+    family = session._prune_family(budgets)
+    assert session._stages == stages  # the session itself is unchanged
+    assert len(family) == len(budgets)
+    for budget, (fork, model) in zip(budgets, family):
+        alone = copy(session)
+        alone._stages = session._stages.copy()
+        expected = alone.prune(max_tables=budget)
+        assert fork._stages['pruned'].revision == alone._stages['pruned'].revision
+        assert model.pruning_report_ == expected.pruning_report_
+        np.testing.assert_array_equal(model.predict(training), expected.predict(training))
+    assert family[0][0]._stages['pruned'].revision == family[3][0]._stages['pruned'].revision
+    assert any('rebalance' in model.pruning_report_ for _, model in family)  # exercised
+
+
+def _family_inputs(session):
+    """The arguments the session's pruning passes to the native family and single calls."""
+    state, result = session._state, session.full_model
+    kwargs = dict(reanchor=result._resolved_reanchor(), rebalance=True,
+                  exposure=state.exposure, cat_x=state.categories,
+                  table_min_arity=int(result.prune_table_min_arity), **result._measure_kwargs())
+    return state, kwargs
+
+
+@pytest.mark.parametrize('n_jobs', [1, 3, None])
+def test_native_pruning_family_equals_the_single_keepset_binding(n_jobs):
+    """The oracle is the native single call itself, not `prune()` (which uses the family)."""
+    import json
+    import polars as pl
+    x, y = book()
+    training = pl.DataFrame({"a": x[:, 0], "b": x[:, 1], "c": x[:, 2],
+                             "region": np.where(x[:, 3] > 0, "north", "south")})
+    session = estimator(prune_rebalance=True).fit_staged(training, y)
+    counts = session.pruning_path['table_counts']
+    keeps = [session.pruning_selection(max_tables=count)['kept']
+             for count in (counts[-1], counts[0], counts[len(counts) // 2])]
+    state, kwargs = _family_inputs(session)
+    family = state.model.apply_keepset_family(state.x, state.y, state.weights, keeps,
+                                              n_jobs=n_jobs, **kwargs)
+    assert len(family) == len(keeps)
+    for keep, (model, box, table, rebalance) in zip(keeps, family):
+        single = state.model.apply_keepset_budgeted(state.x, state.y, state.weights, keep, 0, [],
+                                                    n_jobs=n_jobs, table_budget=0, **kwargs)
+        assert bytes(model.to_bytes()) == bytes(single[0].to_bytes())
+        assert (json.loads(box), json.loads(table)) == (json.loads(single[1]), json.loads(single[2]))
+        assert rebalance is not None and json.loads(rebalance) == json.loads(single[3])
+
+
+def test_a_failing_candidate_fails_the_whole_family_without_publishing():
+    x, y = book()
+    session = estimator(prune_rebalance=True).fit_staged(x, y)
+    counts = session.pruning_path['table_counts']
+    good = session.pruning_selection(max_tables=counts[0])['kept']
+    state, kwargs = _family_inputs(session)
+    # A native failure raises: no partial list of candidates is ever returned.
+    with pytest.raises(ValueError, match="length|len|shape|mismatch"):
+        state.model.apply_keepset_family(state.x, state.y[:-1], state.weights[:-1],
+                                         [good, good], n_jobs=3, **kwargs)
+    stages = dict(session._stages)
+    with pytest.raises(ValueError):
+        session._prune_family([counts[0], -1])
+    assert session._stages == stages
