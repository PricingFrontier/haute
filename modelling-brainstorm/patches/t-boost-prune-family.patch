+/// The row-proportional memory a pruning family's concurrent candidates may use together.
+const FAMILY_DESIGN_BYTES: usize = 1 << 30;
+
+/// The rebalance's peak per-row working buffers, beyond the bank map, binned copy and design.
+const FAMILY_WORKING_BYTES_PER_ROW: usize = 128;
+
+/// How many keep-sets a pruning family prunes at once: at most `threads`, and few enough that
+/// their estimated row-proportional allocations fit in [`FAMILY_DESIGN_BYTES`]. A wave always
+/// holds at least one candidate, so a single very large one may exceed the budget alone.
+///
+/// The estimate per candidate, deliberately conservative (bytes per row):
+/// - the full bank build's per-row cell map, one `u32` per raw feature (`fill_support`);
+/// - a copy of the binned rows, one byte per model axis counted as two (a categorical rebalance
+///   clones them);
+/// - the cell-refit design, four bytes per kept main or pair (it stores `u16` indices);
+/// - 128 for the rebalance's per-row working buffers live at its peak: mass, scores,
+///   gradient and Hessian, residual, weight, row indices, the compacted fit vectors and the
+///   warm start (about 88 bytes measured, with headroom for allocation slack).
+fn family_wave(
+    n_rows: usize,
+    n_raw_features: usize,
+    n_axes: usize,
+    keepsets: &[Vec<FeatureSet>],
+    threads: usize,
+) -> usize {
+    let widest = keepsets
+        .iter()
+        .map(|keep| keep.iter().filter(|u| u.order() <= 2).count())
+        .max()
+        .unwrap_or(0)
+        .max(1);
+    let per_row = n_raw_features
+        .saturating_mul(4)
+        .saturating_add(n_axes.saturating_mul(2))
+        .saturating_add(widest.saturating_mul(4))
+        .saturating_add(FAMILY_WORKING_BYTES_PER_ROW);
+    let per_call = n_rows.saturating_mul(per_row).max(1);
+    (FAMILY_DESIGN_BYTES / per_call)
+        .clamp(1, threads.max(1))
+        .min(keepsets.len().max(1))
