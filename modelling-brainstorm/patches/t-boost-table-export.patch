diff --git a/python/tests/test_table_export.py b/python/tests/test_table_export.py
new file mode 100644
index 0000000..a9a09e9
--- /dev/null
+++ b/python/tests/test_table_export.py
@@ -0,0 +1,90 @@
+"""`table_export` is `tables` as Python data: the same export, parsed once."""
+from __future__ import annotations
+
+import json
+
+import numpy as np
+import polars as pl
+import pytest
+from t_boost import TBoostClassifier, TBoostRegressor
+
+
+def _frame(rows: int = 400, seed: int = 3) -> tuple[pl.DataFrame, np.ndarray]:
+    rng = np.random.default_rng(seed)
+    x = rng.normal(size=(rows, 3)).astype(np.float32)
+    region = np.where(x[:, 2] > 0.3, "north", np.where(x[:, 2] < -0.3, "south", "west"))
+    frame = pl.DataFrame({"a": x[:, 0], "b": x[:, 1], "region": region})
+    signal = 0.4 * x[:, 0] - 0.3 * x[:, 1] + 0.5 * (region == "north")
+    return frame, signal
+
+
+def _regressor(categorical: bool, **params):
+    frame, signal = _frame()
+    y = np.random.default_rng(1).poisson(np.exp(signal - 1)).astype(np.float32)
+    X = frame if categorical else frame.drop("region")
+    estimator = TBoostRegressor(objective="poisson", n_trees=12, n_bags=2, n_jobs=1, seed=5,
+                                **params)
+    return estimator.fit(X, y), X
+
+
+def _classifier(classes: int, **params):
+    frame, signal = _frame()
+    y = np.digitize(signal, np.quantile(signal, np.linspace(0, 1, classes + 1)[1:-1]))
+    return TBoostClassifier(n_trees=12, n_bags=2, n_jobs=1, seed=5, **params).fit(frame, y), frame
+
+
+CASES = {
+    "regressor-numeric": lambda: _regressor(False),
+    "regressor-categorical": lambda: _regressor(True),
+    "binary-categorical": lambda: _classifier(2),
+    "multiclass-categorical": lambda: _classifier(3),
+    # The joint ledger needs unbanded tables; these cover it for every estimator kind.
+    "regressor-unbanded": lambda: _regressor(True, band_tolerance=None),
+    "binary-unbanded": lambda: _classifier(2, band_tolerance=None),
+    "multiclass-unbanded": lambda: _classifier(3, band_tolerance=None),
+}
+# These fits produce banded tables, which the joint ledger refuses.
+BANDED = {"regressor-categorical", "multiclass-categorical"}
+
+
+SUPPORTED = [
+    (case, measure)
+    for case in CASES
+    for measure in (None, "uniform", "joint")
+    if not (measure == "joint" and case in BANDED)
+]
+
+
+@pytest.mark.parametrize(("case", "ref_measure"), SUPPORTED)
+def test_table_export_equals_the_parsed_tables_document(case, ref_measure):
+    estimator, X = CASES[case]()
+    kwargs = {"ref_measure": ref_measure}
+    document = json.loads(estimator.tables(X, **kwargs))
+    export = estimator.table_export(X, **kwargs)
+    assert export == document
+    assert json.dumps(export) == json.dumps(document)  # the same key order too
+
+
+def test_table_export_takes_call_time_mass_like_tables():
+    estimator, X = _regressor(True)
+    weight = np.linspace(0.5, 2.0, len(X)).astype(np.float32)
+    assert estimator.table_export(X, sample_weight=weight) == json.loads(
+        estimator.tables(X, sample_weight=weight)
+    )
+
+
+def test_unseen_cells_are_annotated_on_the_exported_axes():
+    estimator, X = _regressor(True)
+    export = estimator.table_export(X)
+    axes = [axis for table in export["tables"] for axis in table["axes"] if axis.get("levels")]
+    assert axes and all({"rare_pooled", "unseen_cell"} <= set(axis) for axis in axes)
+
+
+@pytest.mark.parametrize("case", sorted(BANDED))
+def test_an_unsupported_joint_export_is_refused_alike(case):
+    estimator, X = CASES[case]()
+    message = "joint-measure ledger does not yet support banded tables"
+    with pytest.raises(ValueError, match=message):
+        estimator.tables(X, ref_measure="joint")
+    with pytest.raises(ValueError, match=message):
+        estimator.table_export(X, ref_measure="joint")
