+def test_path_point_reads_refuse_invalid_members_even_with_matching_checksums(tmp_path, payload):
+    import hashlib
+    import json
+    import zipfile
+
+    from haute.errors import HauteValidationError
+    from haute.modelling._stage_paths import read_path_artifact
+
+    _, full = build(tmp_path)
+    _, pruning = run_stage_job(
+        full.stage_checkpoint_path,
+        operation="pruned",
+        stages=full.staged["configuration"],
+        prepare_path=True,
+        output_dir=str(tmp_path / "prune"),
+    )
+    source = zipfile.ZipFile(pruning.stage_checkpoint_path)
+    manifest = json.loads(source.read("manifest.json"))
+    path_id = manifest["metadata"]["paths"]["pruned"]["id"]
+    member = f"path-{path_id}-point-1.result.json"
+    stored = json.loads(source.read(member))
+    if payload == "foreign-path":
+        stored["staged"]["prepared_path"] = "0" * 64
+        text = json.dumps(stored)
+    elif payload == "legacy":
+        stored["staged"]["paths"] = manifest["metadata"]["paths"]
+        text = json.dumps(stored)
+    elif payload == "manifest-NaN":
+        text = json.dumps(stored)
+        manifest["metadata"]["paths"]["pruned"]["points"][1]["loss"] = float("nan")
+    else:
+        stored["metrics"] = {"poisson_deviance": "__NUMBER__"}
+        text = json.dumps(stored).replace('"__NUMBER__"', payload)
+    data = text.encode()
+    manifest["members"][member] = {"sha256": hashlib.sha256(data).hexdigest(), "bytes": len(data)}
+    tampered = tmp_path / "tampered.hstage"
+    with zipfile.ZipFile(tampered, "w") as target:
+        for info in source.infolist():
+            if info.filename == "manifest.json":
+                target.writestr(info, json.dumps(manifest))
+            elif info.filename == member:
+                target.writestr(info, data)
+            else:
