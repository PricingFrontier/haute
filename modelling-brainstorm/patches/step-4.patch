+    assert p2["id"] != p1["id"] and p2["selected_point"] == p1["selected_point"]
+    assert rebuilt.staged["paths"]["banded"]["id"] == band["id"]
+    with open_stage_bundle(rebuilt.stage_checkpoint_path) as bundle:
+        for point in band["points"]:
