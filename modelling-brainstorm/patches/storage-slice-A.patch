+def _write_parts(path, parts, *, rehash):
+    """Write a portable checkpoint; ``rehash`` recomputes each part's member records."""
+    import hashlib
+    import io
+
+    payloads = {}
+    for name, members in parts.items():
+        members = dict(members)
+        if rehash:
+            manifest = json.loads(members["manifest.json"])
+            manifest["members"] = {
+                member: {"sha256": hashlib.sha256(value).hexdigest(), "bytes": len(value)}
+                for member, value in members.items() if member != "manifest.json"
+            }
+            members["manifest.json"] = json.dumps(manifest).encode()
+        buffer = io.BytesIO()
+        with zipfile.ZipFile(buffer, "w") as archive:
+            for member, value in members.items():
+                archive.writestr(member, value)
+        payloads[name] = buffer.getvalue()
+    with zipfile.ZipFile(path, "w") as portable:
+        portable.writestr("evidence", payloads["evidence"])
+        portable.writestr("chain", payloads["chain"])
+        portable.writestr("manifest.json", json.dumps(
+            {"format": "t-boost-training-checkpoint", "version": 2}))
