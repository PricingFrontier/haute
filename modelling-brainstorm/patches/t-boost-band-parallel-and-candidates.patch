+def test_path_candidates_are_deterministic_bytes(monkeypatch):
+    """Equal candidates are equal bytes at any time: their members carry fixed timestamps."""
+    import time as clock
+    x, y = book()
+    session = estimator().fit_staged(x, y)
+    family = session.prepare_path('pruned', parent='full')
+    point = next(p['id'] for p in family.points if not p['identity'])
+    first = family.candidate_bytes(point)
+    later = clock.time() + 3600
+    monkeypatch.setattr(clock, 'time', lambda: later)
+    monkeypatch.setattr(clock, 'localtime', lambda *a: clock.gmtime(later))
+    assert family.candidate_bytes(point) == first
