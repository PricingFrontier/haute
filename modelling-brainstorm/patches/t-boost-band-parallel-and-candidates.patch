+/// The row-proportional memory a band family's concurrent candidates may use together.
+const BAND_FAMILY_BYTES: usize = 1 << 30;
+
+/// How many banding candidates run at once: at most `threads` and `requests`, and few enough
+/// that their estimated row-proportional allocations fit in [`BAND_FAMILY_BYTES`]. A wave
+/// always holds one candidate, so a single very large one may exceed the budget alone.
+///
+/// The estimate per candidate, deliberately conservative (bytes per row):
+/// - distillation's band index of every row in every table: a `u32`, plus the `usize` it is
+///   built from (12 per table);
+/// - its copy of the merged-grid row cells, a `u32` per raw feature;
+/// - 128 for its per-row working vectors (predictions, residuals, calibration buffers).
+fn band_wave(
+    n_rows: usize,
+    n_tables: usize,
+    n_raw: usize,
+    requests: usize,
+    threads: usize,
+) -> usize {
+    let per_row = n_tables
+        .saturating_mul(12)
+        .saturating_add(n_raw.saturating_mul(4))
+        .saturating_add(128);
+    let per_candidate = n_rows.saturating_mul(per_row).max(1);
+    (BAND_FAMILY_BYTES / per_candidate)
+        .clamp(1, threads.max(1))
+        .min(requests.max(1))
+}
