+    fn a_band_wave_holds_one_to_threads_candidates_within_the_memory_budget() {
+        use super::{band_wave, BAND_FAMILY_BYTES};
+        let per = |rows: usize, tables: usize, raw: usize| rows * (tables * 12 + raw * 4 + 128);
+        // Small data: bounded by the requests, then by the threads.
+        assert_eq!(band_wave(1_000, 10, 5, 7, 32), 7);
+        assert_eq!(band_wave(1_000, 10, 5, 7, 3), 3);
+        assert_eq!(band_wave(1_000, 10, 5, 0, 8), 1);
+        // 542k rows and 500 tables: one candidate already exceeds the budget, so one at a time.
+        assert_eq!(band_wave(542_000, 500, 10, 16, 32), 1);
+        // Otherwise as many as fit together.
+        let wave = band_wave(542_000, 35, 10, 16, 32);
+        assert_eq!(
+            wave,
+            (BAND_FAMILY_BYTES / per(542_000, 35, 10)).clamp(1, 16)
+        );
+        assert!(wave * per(542_000, 35, 10) <= BAND_FAMILY_BYTES);
+    }
