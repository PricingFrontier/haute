                    "title": "Op",
                    "type": "string"
                  },
                  "node": {
                    "description": "Node id, or a batch-local $ref declared by an earlier add_node.",
                    "title": "Node",
                    "type": "string"
                  }
                },
                "required": [
                  "op",
                  "node"
                ],
                "title": "DeleteNodeOp",
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "op": {
                    "const": "add_edge",
                    "default": "add_edge",
                    "title": "Op",
                    "type": "string"
                  },
                  "source": {
                    "description": "Node id, or a batch-local $ref declared by an earlier add_node.",
                    "title": "Source",
                    "type": "string"
                  },
                  "target": {
                    "description": "Node id, or a batch-local $ref declared by an earlier add_node.",
                    "title": "Target",
                    "type": "string"
                  },
                  "source_handle": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "Output port on the source node, exactly as get_pipeline reports it under an edge's 'source_handle'. Required only when the source emits several frames, such as an apiInput table; omit it for an ordinary single-output node.",
                    "title": "Source Handle"
