{
  "factors": [
    {
      "banding": "breakpoints",
      "column": "driver_age",
      "output_column": "age_band",
      "rules": [
        {"upper": 24, "label": "17-24"},
        {"upper": 59, "label": "25-59"},
        {"label": "60+"}
      ],
      "default": "unknown"
    },
    {
      "banding": "breakpoints",
      "column": "inception_date",
      "output_column": "inception_year",
      "rules": [
        {"upper": "2024-12-31", "label": "2024"},
        {"label": "2025+"}
      ],
      "default": "unknown"
    },
    {
      "banding": "categorical",
      "column": "region_code",
      "output_column": "region",
      "rules": {
        "NE": "North",
        "NW": "North",
        "SE": "South",
        "LON": "London"
      },
      "default": "Other"
    }
  ]
}
