            "golden": "df = pl.scan_parquet('data/policies.parquet').with_columns(\n    vehicle_age=2025 - pl.col('vehicle_year'),\n).with_columns(\n    vehicle_factor=pl.when(pl.col('vehicle_age') > 10).then(1.2).otherwise(1.0),\n).with_columns(\n    premium=(pl.col('base_rate') * pl.col('vehicle_factor')).round(2),\n).with_columns(high_risk_vehicle=pl.col('vehicle_factor') > 1)\n",
