{
  "node_type": "modelling",
  "authorable": true,
  "fields": {
    "name": "The model's name, used for its saved files and MLflow run.",
    "target": "The column to predict; never also a feature.",
    "feature_columns": "The predictor columns. Target, weight and offset columns are never features.",
    "algorithm": "The model family, lower case: \"catboost\", \"xgboost\", \"lightgbm\" and \"ebm\" are tree families; \"glm\" is a generalised linear model.",
    "task": "\"regression\" or \"classification\"; a GLM trains regression only.",
    "loss_function": "Tree families: the training loss, required: \"RMSE\", \"MAE\", \"Poisson\", \"Gamma\", \"Tweedie\" (with variance_power between 1 and 2), \"Logloss\" or \"CrossEntropy\". CatBoost has no Gamma.",
    "params": "Tree families: the family's own hyperparameters, such as CatBoost's iterations, depth and learning_rate. Unknown keys fail when training starts.",
    "family / link": "GLM: the distribution and link, lower case: \"poisson\" with \"log\" for claim counts, \"gamma\" with \"log\" for severity, \"tweedie\" (with var_power) for burning cost, \"gaussian\" with \"identity\".",
    "terms": "GLM: {column: {\"type\": ...}} per predictor: \"linear\", \"categorical\" (optional reference level), \"ns\"/\"bs\" splines with df, or an encoding.",
    "offset": "A strictly positive exposure column, such as exposure in years. Under a log link (a log-link GLM, or a Poisson or Tweedie tree loss) it multiplies the prediction; do not log it yourself.",
    "weight": "Optional row-weight column.",
    "evaluation": "Required before the node can train. How rows are held out: {\"schema_version\": 1, \"strategy\": \"random\", \"seed\": n, \"validation\": {\"method\": \"single\", \"size\": 0.2}}.",
    "wiring": "A Model Training node has no output and ends its branch; the analyst trains it from the node, and a Model Scoring node scores with the trained model."
  },
  "inputs": [
    {
      "edge": "policies",
      "columns": {
        "policy_id": "String",
        "driver_age": "Int64",
        "region": "String",
        "vehicle_value": "Float64",
        "exposure": "Float64",
        "claim_count": "Int64",
        "claim_cost": "Float64"
      }
    }
  ],
  "configs": [
    {
      "name": "minimal",
      "intent": "Train a CatBoost claim-cost model with a squared-error loss.",
      "config": {
        "name": "claim_cost_gbm",
        "target": "claim_cost",
        "feature_columns": ["driver_age", "region", "vehicle_value"],
        "algorithm": "catboost",
        "task": "regression",
        "loss_function": "RMSE",
        "params": {"iterations": 20, "depth": 3, "learning_rate": 0.1},
        "evaluation": {
          "schema_version": 1,
          "strategy": "random",
          "seed": 42,
          "validation": {"method": "single", "size": 0.2}
        }
      },
      "produces": ["claim_cost"]
    },
    {
      "name": "realistic",
      "intent": "Train a Poisson claim-frequency GLM under a log link with exposure as the offset.",
      "config": {
        "name": "frequency_glm",
        "target": "claim_count",
        "algorithm": "glm",
        "task": "regression",
        "family": "poisson",
        "link": "log",
        "offset": "exposure",
        "terms": {
          "driver_age": {"type": "linear"},
          "region": {"type": "categorical", "reference": "South"}
        },
        "evaluation": {
          "schema_version": 1,
          "strategy": "random",
          "seed": 42,
          "validation": {"method": "single", "size": 0.2}
        }
      },
      "produces": ["claim_count", "exposure"]
    }
  ],
