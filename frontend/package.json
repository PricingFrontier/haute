{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=10.9.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "analyze:bundle": "tsc -b && vite build --sourcemap && node scripts/analyze-bundle-sourcemaps.mjs",
    "generate:contracts": "cd .. && uv run python scripts/generate_api_contracts.py && cd frontend && node scripts/generate-api-contracts.mjs",
    "check:contracts": "node --test scripts/generate-api-contracts.test.mjs && node scripts/generate-api-contracts.mjs --check",
    "check:bundle": "node scripts/check-bundle-size.mjs && node scripts/check-ui-dependencies.mjs",
    "check:ui-deps": "node scripts/check-ui-dependencies.mjs",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:shuffle": "vitest run --sequence.shuffle",
    "test:coverage": "vitest run --coverage && node scripts/check-critical-coverage.mjs",
    "test:benchmark:pr": "vitest run src/__tests__/App.shallowHash.test.ts src/utils/__tests__/columnFingerprint.test.ts src/hooks/__tests__/nodesWithStatus.memo.test.tsx src/utils/__tests__/graphPerformance.test.ts",
    "test:e2e": "playwright test --grep-invert @benchmark",
    "test:e2e:benchmark": "playwright test --grep @benchmark --project=chromium --retries=0",
    "test:e2e:smoke": "playwright test --grep @smoke --retries=0",
    "test:e2e:headed": "playwright test --headed"
  },
  "criticalCoverage": {
    "artifact": "coverage/coverage-summary.json",
    "entries": [
      {
        "pattern": "src/api/client.ts",
        "thresholds": {
          "statements": 85,
          "branches": 90,
          "functions": 84,
          "lines": 86
