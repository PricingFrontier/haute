{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "analyze:bundle": "tsc -b && vite build --sourcemap && node scripts/analyze-bundle-sourcemaps.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs && node scripts/check-ui-dependencies.mjs",
    "check:ui-deps": "node scripts/check-ui-dependencies.mjs",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && node scripts/check-critical-coverage.mjs",
    "test:e2e": "playwright test --grep-invert @benchmark",
    "test:e2e:benchmark": "playwright test --grep @benchmark --project=chromium --retries=0",
    "test:e2e:smoke": "playwright test --grep @smoke --retries=0",
    "test:e2e:headed": "playwright test --headed"
  },
  "criticalCoverage": {
    "artifact": "coverage/coverage-summary.json",
    "entries": [
      {
        "pattern": "src/api/client.ts",
        "thresholds": {
          "statements": 85,
          "branches": 90,
          "functions": 84,
          "lines": 86
        }
      },
      {
        "pattern": "src/hooks/usePipelineAPI.ts",
        "thresholds": {
          "statements": 82,
          "branches": 63,
          "functions": 68,
          "lines": 85
        }
      },
      {
        "pattern": "src/hooks/useWebSocketSync.ts",
        "thresholds": {
          "statements": 96,
          "branches": 86,
          "functions": 100,
          "lines": 99
        }
      },
      {
        "pattern": "src/stores/use*Store.ts",
        "thresholds": {
          "statements": 94,
          "branches": 87,
          "functions": 91,
          "lines": 95
        }
      },
      {
        "pattern": "src/types/guards.ts",
        "thresholds": {
          "statements": 86,
          "branches": 70,
          "functions": 85,
          "lines": 87
        }
      },
      {
        "pattern": "src/hooks/useNodeHandlers.ts",
        "thresholds": {
          "statements": 91,
          "branches": 80,
          "functions": 76,
          "lines": 100
        }
      },
      {
        "pattern": "src/hooks/useEdgeHandlers.ts",
        "thresholds": {
          "statements": 98,
          "branches": 95,
          "functions": 94,
          "lines": 98
        }
      },
      {
        "pattern": "src/hooks/useGraphCanvasState.ts",
        "thresholds": {
          "statements": 96,
          "branches": 89,
          "functions": 94,
          "lines": 97
        }
      },
      {
        "pattern": "src/utils/validateConfigRefs.ts",
        "thresholds": {
          "statements": 100,
          "branches": 92,
          "functions": 100,
          "lines": 100
        }
      },
      {
        "pattern": "src/utils/buildGraph.ts",
        "thresholds": {
          "statements": 100,
          "branches": 100,
          "functions": 100,
          "lines": 100
        }
      },
      {
        "pattern": "src/panels/NodePanel.tsx",
        "thresholds": {
          "statements": 92,
          "branches": 81,
          "functions": 93,
          "lines": 96
        }
      },
      {
        "pattern": "src/panels/editors/banding/bandingUtils.ts",
        "thresholds": {
          "statements": 94,
          "branches": 88,
          "functions": 100,
          "lines": 95
        }
      },
      {
        "pattern": "src/panels/editors/rating/ratingTableUtils.ts",
        "thresholds": {
          "statements": 100,
          "branches": 92,
          "functions": 100,
          "lines": 100
        }
      },
      {
        "pattern": "src/components/RemotePushControl.tsx",
        "thresholds": {
          "statements": 92,
          "branches": 84,
          "functions": 95,
          "lines": 97
        }
      },
      {
        "pattern": "src/components/DivergenceModal.tsx",
        "thresholds": {
          "statements": 96,
          "branches": 92,
          "functions": 95,
          "lines": 97
        }
      }
    ]
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.2",
    "@codemirror/lint": "^6.9.5",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.16",
    "@tailwindcss/vite": "^4.1.18",
    "@xyflow/react": "^12.10.0",
    "elkjs": "^0.11.0",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.0",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^6.3.5",
    "vitest": "^4.0.18"
  }
}
