{
  "about": "Whether a quote has anything typed to price or save: a value in a column the sheets show, or in any column of quote_details but those the quote store keeps alone (its stage, who it is with, whether it is archived, when and by whom it was last changed and its Haute version), which no request holds, as a request holds the rest of quote_details whatever the sheets hide, other than a column the app sets (locked), whose value decides what the sheets show as any value does, the index, the column giving a table its rows, and a one-row table's column holding the default a new quote starts it with. Each case gives the values (rows by table name, cells by column name), the locked columns as [table, column], and whether the quote is typed. The form spells each table's inputs and outputs, each column with what it sets, the rest as a new column's. frontend/src/utils/__tests__/sheetVisibility.test.ts holds quoteEligible to every case, and tests/test_workbench_tables.py holds the server's rule to them, the locked columns' values left out first as the app's routes leave out the details they set: one rule in two languages.",
  "form": {
    "version": 1,
    "name": "typed",
    "schema": {
      "tables": [
        {
          "name": "quote_details",
          "rows": "one",
          "inputs": [
            { "name": "quote_reference" },
            { "name": "quote_option", "type": "int" },
            { "name": "quote_name" },
            { "name": "insured" },
            { "name": "broker" },
            { "name": "inception_date", "type": "date" },
            { "name": "expiry_date", "type": "date" },
            { "name": "is_renewal", "type": "bool" },
            { "name": "stage" },
            { "name": "assignee" },
            { "name": "archived", "type": "bool" },
            { "name": "created_date", "type": "date" },
            { "name": "created_by" },
            { "name": "modified_date", "type": "date" },
            { "name": "modified_by" },
            { "name": "haute_version" }
          ],
          "outputs": []
        },
        {
          "name": "policy",
          "rows": "one",
          "inputs": [
            { "name": "state" },
            { "name": "limit", "type": "int", "default_value": "1000" },
            { "name": "flood_cover", "type": "bool" },
            { "name": "reference" }
          ],
          "outputs": []
        },
        {
          "name": "flood",
          "rows": "one",
          "inputs": [{ "name": "flood_si", "type": "float" }],
          "outputs": []
        },
        {
          "name": "perils",
          "rows": "many",
          "inputs": [
            { "name": "peril", "options": ["AOP", "EQ"], "index": "values", "options_source": { "file": "perils.csv", "column": "peril" } },
            { "name": "peril_limit", "type": "float" }
          ],
          "outputs": []
        },
        {
          "name": "pricing",
          "rows": "one",
          "inputs": [],
          "outputs": [{ "name": "premium", "type": "float" }]
        },
        {
          "name": "equipment",
          "rows": "many",
          "inputs": [
            { "name": "row_number", "type": "int", "index": "numbered" },
            { "name": "item" },
            { "name": "value", "type": "float" }
          ],
          "outputs": [{ "name": "premium", "type": "float" }]
        },
        {
          "name": "sites",
          "rows": "many",
          "inputs": [
            { "name": "site_name", "type": "str", "index": "typed" },
            { "name": "site_value", "type": "float" }
          ],
          "outputs": []
        },
        {
          "name": "extras",
          "rows": "one",
          "inputs": [{ "name": "on_inputs" }, { "name": "on_outputs" }, { "name": "on_both" }, { "name": "on_count" }],
          "outputs": []
        }
      ]
    },
    "pages": [
      {
        "id": "p_main",
        "title": "Main",
        "width": 1280,
        "sections": [
          {
            "id": "s_main",
            "title": "Section 1",
            "height": 640,
            "widgets": [
              {
                "id": "w_policy",
                "name": "w_policy",
                "x": 0,
                "y": 0,
                "w": 720,
                "h": 120,
                "type": "collection",
                "fields": [
                  { "table": "policy", "column": "state" },
                  { "table": "policy", "column": "limit" },
                  { "table": "policy", "column": "flood_cover" },
                  { "table": "policy", "column": "reference" },
                  { "table": "quote_details", "column": "created_by" }
                ]
              },
              {
                "id": "w_flood",
                "name": "w_flood",
                "x": 0,
                "y": 160,
                "w": 720,
                "h": 120,
                "type": "collection",
                "fields": [
                  { "table": "flood", "column": "flood_si" },
                  { "table": "quote_details", "column": "stage" }
                ],
                "show_when": {
                  "match": "all",
                  "conditions": [{ "table": "policy", "column": "flood_cover", "op": "ticked", "values": [], "field": null, "days": 0 }]
                }
              },
              {
                "id": "w_perils",
                "name": "w_perils",
                "x": 0,
                "y": 320,
                "w": 720,
                "h": 200,
                "type": "tableInput",
                "fields": [
                  { "table": "perils", "column": "line" },
                  { "table": "perils", "column": "peril" },
                  { "table": "perils", "column": "peril_limit" }
                ]
              },
              {
                "id": "w_made",
                "name": "w_made",
                "x": 0,
                "y": 540,
                "w": 720,
                "h": 80,
                "type": "collection",
                "fields": [{ "table": "flood", "column": "flood_si" }],
                "show_when": {
                  "match": "all",
                  "conditions": [{ "table": "quote_details", "column": "created_by", "op": "equals", "values": ["ana@example.com"], "field": null, "days": 0 }]
                }
              },
              {
                "id": "w_equipment",
                "name": "w_equipment",
                "x": 760,
                "y": 0,
                "w": 480,
                "h": 80,
                "type": "tableInput",
                "fields": [{ "table": "equipment", "column": "item" }, { "table": "equipment", "column": "value" }, { "table": "equipment", "column": "premium" }]
              },
              {
                "id": "w_sites_index",
                "name": "w_sites_index",
                "x": 760,
                "y": 500,
                "w": 480,
                "h": 80,
                "type": "tableInput",
                "fields": [{ "table": "sites", "column": "site_name" }]
              },
              {
                "id": "w_sites_value",
                "name": "w_sites_value",
                "x": 760,
                "y": 560,
                "w": 480,
                "h": 80,
                "type": "tableInput",
                "fields": [{ "table": "sites", "column": "site_value" }],
                "show_when": {
                  "match": "all",
                  "conditions": [{ "table": "policy", "column": "flood_cover", "op": "ticked", "values": [], "field": null, "days": 0 }]
                }
              },
              {
                "id": "w_on_inputs",
                "name": "w_on_inputs",
                "x": 760,
                "y": 100,
                "w": 480,
                "h": 80,
                "type": "collection",
                "fields": [{ "table": "extras", "column": "on_inputs" }],
                "show_when": {
                  "match": "all",
                  "conditions": [{ "table": "equipment", "rows": "any", "where": [{ "column": "value", "op": "above", "values": ["1000"], "field": null, "days": 0 }] }]
                }
              },
              {
                "id": "w_on_outputs",
                "name": "w_on_outputs",
                "x": 760,
                "y": 200,
                "w": 480,
                "h": 80,
                "type": "collection",
                "fields": [{ "table": "extras", "column": "on_outputs" }],
                "show_when": {
                  "match": "all",
                  "conditions": [{ "table": "equipment", "rows": "any", "where": [{ "column": "premium", "op": "above", "values": ["0"], "field": null, "days": 0 }] }]
                }
              },
              {
                "id": "w_on_both",
                "name": "w_on_both",
                "x": 760,
                "y": 300,
                "w": 480,
                "h": 80,
                "type": "collection",
                "fields": [{ "table": "extras", "column": "on_both" }],
                "show_when": {
                  "match": "all",
                  "conditions": [{ "table": "equipment", "rows": "any", "where": [{ "column": "value", "op": "above", "values": ["1000"], "field": null, "days": 0 }, { "column": "premium", "op": "above", "values": ["0"], "field": null, "days": 0 }] }]
                }
              },
              {
                "id": "w_on_count",
                "name": "w_on_count",
                "x": 760,
                "y": 400,
                "w": 480,
                "h": 80,
                "type": "collection",
                "fields": [{ "table": "extras", "column": "on_count" }],
                "show_when": {
                  "match": "all",
                  "conditions": [{ "table": "equipment", "where": [], "op": "at_least", "count": 1 }]
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "cases": [
    { "name": "nothing", "values": {}, "locked": [], "typed": false },
    { "name": "a value", "values": { "policy": [{ "state": "NY" }] }, "locked": [], "typed": true },
    { "name": "blank text", "values": { "policy": [{ "state": "  " }] }, "locked": [], "typed": false },
    { "name": "a tick", "values": { "policy": [{ "flood_cover": true }] }, "locked": [], "typed": true },
    { "name": "the default alone", "values": { "policy": [{ "limit": "1000" }] }, "locked": [], "typed": false },
    { "name": "a value other than the default", "values": { "policy": [{ "limit": "2000" }] }, "locked": [], "typed": true },
    { "name": "the default beside a value", "values": { "policy": [{ "limit": "1000", "state": "NY" }] }, "locked": [], "typed": true },
    { "name": "a value the sheets hide", "values": { "flood": [{ "flood_si": "5000" }] }, "locked": [], "typed": false },
    { "name": "a value the sheets show once its condition holds", "values": { "policy": [{ "flood_cover": true }], "flood": [{ "flood_si": "5000" }] }, "locked": [], "typed": true },
    { "name": "a value the app sets", "values": { "policy": [{ "reference": "Q-000001" }] }, "locked": [["policy", "reference"]], "typed": false },
    { "name": "a value the app sets beside one typed", "values": { "policy": [{ "reference": "Q-000001", "state": "NY" }] }, "locked": [["policy", "reference"]], "typed": true },
    { "name": "the rows a column gives alone", "values": { "perils": [{ "peril": "AOP" }, { "peril": "EQ" }] }, "locked": [], "typed": false },
    { "name": "a value in a row a column gives", "values": { "perils": [{ "peril": "EQ", "peril_limit": "250" }] }, "locked": [], "typed": true },
    { "name": "a value in a row no allowed value gives", "values": { "perils": [{ "peril": "AOP" }, { "peril": "EQ" }, { "peril": "XX", "peril_limit": "9" }] }, "locked": [], "typed": false },
    { "name": "a second row of a one-row table", "values": { "policy": [{}, { "state": "NY" }] }, "locked": [], "typed": false },
    { "name": "a table the form no longer has", "values": { "gone": [{ "state": "NY" }] }, "locked": [], "typed": false },
    { "name": "a stage alone, which no request holds", "values": { "quote_details": [{ "stage": "draft" }] }, "locked": [], "typed": false },
    { "name": "a quote name, which a request holds whatever the sheets hide", "values": { "quote_details": [{ "quote_name": "Fleet" }] }, "locked": [], "typed": true },
    { "name": "a stage the sheets hide, set by the app", "values": { "quote_details": [{ "stage": "draft" }] }, "locked": [["quote_details", "stage"]], "typed": false },
    { "name": "a value shown by a detail the app sets", "values": { "quote_details": [{ "created_by": "ana@example.com" }], "flood": [{ "flood_si": "5000" }] }, "locked": [["quote_details", "created_by"]], "typed": true },
    { "name": "a value a detail the app sets leaves hidden", "values": { "quote_details": [{ "created_by": "jo@example.com" }], "flood": [{ "flood_si": "5000" }] }, "locked": [["quote_details", "created_by"]], "typed": false },
    { "name": "a value typed into the inputs of a table of both blocks", "values": { "equipment": [{ "item": "Crane" }] }, "locked": [], "typed": true },
    { "name": "a value under an output's name, which nothing types", "values": { "equipment": [{ "premium": "100" }] }, "locked": [], "typed": false },
    { "name": "a value a condition on a table's inputs hides, nothing typed there", "values": { "extras": [{ "on_inputs": "x" }] }, "locked": [], "typed": false },
    { "name": "a value a condition on a table's outputs leaves shown: the price never decides what is priced", "values": { "extras": [{ "on_outputs": "x" }] }, "locked": [], "typed": true },
    { "name": "a value a condition naming inputs and outputs hides: it never holds", "values": { "extras": [{ "on_both": "x" }] }, "locked": [], "typed": false },
    { "name": "a value a count without tests hides while its table has no typed row", "values": { "extras": [{ "on_count": "x" }] }, "locked": [], "typed": false },
    {
      "name": "a typed index alone while every ordinary input in its table is hidden",
      "values": { "sites": [{ "site_name": "Leeds" }] },
      "locked": [],
      "typed": true,
      "index_problems": []
    },
    {
